# Dockerfile para Desenvolvimento com Hot Reload
FROM node:18-alpine

WORKDIR /app

# Copiar apenas package files primeiro (cache layer)
COPY package*.json ./

# Instalar TODAS as dependências (incluindo devDependencies para nodemon)
RUN npm ci

# Expor a porta
EXPOSE 3001

# Comando padrão será sobrescrito pelo docker-compose
CMD ["npm", "run", "dev"]

