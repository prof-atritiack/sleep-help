# Dockerfile para Desenvolvimento com Hot Reload
FROM node:18-alpine

WORKDIR /app

# Copiar apenas package files primeiro (cache layer)
COPY package*.json ./

# Instalar TODAS as dependências (incluindo devDependencies)
RUN npm ci

# Expor a porta do React dev server
EXPOSE 3000

# Comando padrão será sobrescrito pelo docker-compose
CMD ["npm", "start"]

